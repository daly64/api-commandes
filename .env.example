# Copiez ce fichier en « .env » et remplacez les valeurs.

# Chaîne de connexion fournie par Neon (console.neon.tech, bouton « Connect »)
DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxxx.eu-central-1.aws.neon.tech/api-commandes-db?sslmode=require

# SSL : laissez « true » pour Neon ; « false » uniquement pour une base PostgreSQL locale
DATABASE_SSL=true

# Clé d'accès du personnel : une longue chaîne aléatoire
API_KEY=remplacez-par-une-cle-longue-et-aleatoire

# Adresse du menu (facultatif, cette valeur est celle par défaut)
MENU_URL=https://menu-board-api-murex.vercel.app/menu

# Port (facultatif, 3000 par défaut ; les hébergeurs le fournissent souvent eux-mêmes)
PORT=3000
